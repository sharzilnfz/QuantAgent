# ==============================================================================
# Comprehensive .dockerignore for QuantAgent
# Excludes local dependencies, caches, build artifacts, environments, and secrets
# ==============================================================================

# Node / JavaScript dependencies and caches
node_modules
**/node_modules
.pnpm-store
**/.pnpm-store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn

# Python virtual environments and bytecode caches
.venv
**/.venv
venv
**/venv
env
**/env
.Python
__pycache__
**/__pycache__
*.pyc
**/*.pyc
*.pyo
**/*.pyo
*.pyd
**/*.pyd

# Test and linter caches / reports
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
.coverage
**/coverage
htmlcov
**/.mypy_cache
.vitest
**/.vitest

# Build outputs and build caches
dist
**/dist
build
**/build
out
**/out
.turbo
**/.turbo
.next
**/.next
*.tsbuildinfo
**/*.tsbuildinfo
.cache
**/.cache

# Version control and worktrees
.git
**/.git
.gitignore
.gitattributes
.worktrees
**/.worktrees

# Environment files and sensitive credentials
.env
.env.*
.env*.local
*.pem
*.key
*.cert
*.crt

# System logs
*.log
**/*.log

# OS-generated files and IDE settings
.DS_Store
**/.DS_Store
Thumbs.db
**/.idea
**/.vscode

# Agent, scratch, and temporary assistant workspaces
.agents
.claude
.codex
.gemini
.impeccable
.scratch
.cbmignore

# Documentation, specifications, and demo scripts not required in image runtime
docs
specs
demo
*.md
