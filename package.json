{
  "name": "quantagent",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent paper-trading platform",
  "scripts": {
    "dev:backend": "pnpm --filter @quantagent/backend dev",
    "dev:frontend": "pnpm --filter @quantagent/frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @quantagent/backend test",
    "test:shared": "pnpm --filter @quantagent/shared test",
    "test:frontend": "pnpm --filter @quantagent/frontend test",
    "db:generate": "pnpm --filter @quantagent/backend db:generate",
    "db:migrate": "pnpm --filter @quantagent/backend db:migrate",
    "db:seed": "pnpm --filter @quantagent/backend db:seed"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
