{
  "name": "@committee/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "pnpm --filter @committee/db migrate && pnpm --filter @committee/db seed && tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest:prices": "tsx src/ingest/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@committee/contracts": "workspace:*",
    "@committee/db": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
