# === Database (M4 / spec 01) ===
DATABASE_URL=postgres://committee:committee@localhost:5432/committee

# === Auth & credential vault (M4 / spec 03) ===
# 32-byte key, base64-encoded. Generate: openssl rand -base64 32
CREDENTIAL_ENC_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SESSION_TTL=604800            # seconds (7 days)

# === Alpaca market data + paper trading (M2 / spec 04) ===
ALPACA_KEY=REPLACE_ME
ALPACA_SECRET=REPLACE_ME
ALPACA_DATA_URL=https://data.alpaca.markets

# === LLM Provider (M1 / spec 07) ===
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
LLM_PROVIDER=auto              # auto | gemini | openrouter | openai | anthropic
LLM_CHEAP_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Automatic Fallback: When GEMINI_API_KEY is configured alongside a primary provider
# (e.g. OpenRouter or Anthropic), Gemini Free API automatically acts as a zero-cost fallback
# if the primary LLM fails or hits rate limits.

# === Quant service (M2 / spec 05) ===
QUANT_SERVICE_URL=http://localhost:8000

# === Telegram Bot (M4 / spec 14) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === API / web ===
API_PORT=3000
WEB_PORT=5173
VITE_API_URL=http://localhost:3000
