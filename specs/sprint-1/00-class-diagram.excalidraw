    {
      "type": "text", "id": "box_ingest_body", "x": 540, "y": 706, "width": 340, "height": 140,
      "text": "CLI: ingest:prices --symbols --from --to\nPOST /ingest/prices (auth-guarded)\n─────────────────────\nupsert on (symbol,tf,ts)\nidempotent: re-run safe\n→ price_bars (as_of stamped)\n─────────────────────\nchunk long ranges\ncache raw API responses\n{ inserted, skipped }",
      "originalText": "CLI: ingest:prices --symbols --from --to\nPOST /ingest/prices (auth-guarded)\n─────────────────────\nupsert on (symbol,tf,ts)\nidempotent: re-run safe\n→ price_bars (as_of stamped)\n─────────────────────\nchunk long ranges\ncache raw API responses\n{ inserted, skipped }",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
