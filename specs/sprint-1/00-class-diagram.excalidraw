    {
      "type": "text", "id": "box_alpaca_body", "x": 130, "y": 706, "width": 340, "height": 100,
      "text": "ALPACA_KEY / ALPACA_SECRET (env)\nALPACA_DATA_URL\n─────────────────────\nfetchBars(symbol, tf, from, to)\n  → PriceBar[] (normalized)\n  as_of = session close time\nretry + backoff on 429",
      "originalText": "ALPACA_KEY / ALPACA_SECRET (env)\nALPACA_DATA_URL\n─────────────────────\nfetchBars(symbol, tf, from, to)\n  → PriceBar[] (normalized)\n  as_of = session close time\nretry + backoff on 429",
