    {
      "type": "text", "id": "box_runner_body", "x": 2280, "y": 396, "width": 380, "height": 160,
      "text": "runAgents(input, agents[], opts?)\n  → { runId, outputs: AgentOutput[] }\n─────────────────────────\ncreates agent_runs row (decisionTs)\nPromise.allSettled (parallel)\nvalidates each output\npersists to agent_outputs\n─────────────────────────\nstatus: running → completed|failed\nstructured log per runId\nNO_OPINION on any failure",
      "originalText": "runAgents(input, agents[], opts?)\n  → { runId, outputs: AgentOutput[] }\n─────────────────────────\ncreates agent_runs row (decisionTs)\nPromise.allSettled (parallel)\nvalidates each output\npersists to agent_outputs\n─────────────────────────\nstatus: running → completed|failed\nstructured log per runId\nNO_OPINION on any failure",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e293b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
